NEXT_PUBLIC_AMAP_KEY=your_amap_web_js_key_here
NEXT_PUBLIC_AMAP_SECURITY_CODE=your_amap_security_code_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-plus
# DeepSeek official API; optional permanent server-side configuration.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DUFFEL_ACCESS_TOKEN=your_duffel_access_token_here

# Optional: your authorized supplier adapter (not a raw Ctrip endpoint).
# It must implement POST {BOOKING_GATEWAY_URL}/search; see docs/booking-integration.md.
BOOKING_GATEWAY_URL=
BOOKING_GATEWAY_TOKEN=
# Exact HTTPS checkout hostnames returned by the authorized gateway, comma separated.
BOOKING_CHECKOUT_HOSTS=

# Optional private LiteAPI SANDBOX key. Empty uses the official public sandbox sample.
# Production keys are deliberately rejected by /api/hotel-trial.
LITEAPI_SANDBOX_KEY=

# Domestic hotel + flight official supplier; server-only, never NEXT_PUBLIC.
TUNIU_API_KEY=

# Separate licensed rental supplier adapter. This is our gateway contract, not a Tuniu endpoint.
CAR_RENTAL_GATEWAY_URL=
CAR_RENTAL_GATEWAY_TOKEN=
CAR_RENTAL_PROVIDER_NAME=
