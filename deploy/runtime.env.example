# Copy to runtime.env on the server only. Never commit real credentials.
ROADBOOK_DOMAIN=travel.example.com
ROADBOOK_TEST_USER=tester
# Generate interactively with: docker run --rm -it caddy:2 caddy hash-password
# In a Compose env file, single-quote the bcrypt hash to preserve dollar signs.
ROADBOOK_TEST_PASSWORD_HASH='replace-with-bcrypt-hash'
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
TUNIU_API_KEY=
